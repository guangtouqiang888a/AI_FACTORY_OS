{
  "manifest_version": 3,
  "name": "AI_FACTORY_OS Xianyu Collector",
  "version": "1.0.0",
  "description": "Browser-native market acquisition agent for AI_FACTORY_OS (Entry 065)",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://*.goofish.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI_FACTORY_OS Xianyu Collector"
  },
  "content_scripts": [
    {
      "matches": ["https://*.goofish.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
