{
    "manifest_version": 3,
    "name": "闲鱼全自动高热度采集器",
    "version": "1.3",
    "permissions": ["activeTab", "scripting", "storage"],
    "action": {
      "default_popup": "popup.html"
    },
    "content_scripts": [
      {
        "matches": ["*://*.goofish.com/*", "*://*.2yuanbao.com/*"],
        "js": ["content.js"]
      }
    ]
  }